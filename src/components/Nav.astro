---
import { Image } from "astro:assets";
import wordmark from "../assets/nau-wordmark.png";

const research = [
  { name: "Research Impact", href: "/research/" },
  { name: "Publications", href: "/publications/" },
  { name: "Research Themes", href: "/research-themes/" },
  { name: "About the Data", href: "/about/" },
];
const opportunities = [
  { name: "Overview", href: "/student-opportunities/" },
  { name: "Undergraduate Degrees", href: "/student-opportunities/undergraduate-degrees/" },
  { name: "Graduate Degrees", href: "/student-opportunities/graduate-degrees/" },
  { name: "Professional Certificates", href: "/student-opportunities/professional-certificates/" },
  { name: "Graduate Certificates", href: "/student-opportunities/graduate-certificates/" },
  { name: "Undergraduate Certificates", href: "/student-opportunities/undergraduate-certificates/" },
  { name: "Sisk Fellowship", href: "/student-opportunities/sisk-fellowship/" },
];

const path = Astro.url.pathname;
const isActive = (href: string) =>
  href === "/" ? path === "/" : path.startsWith(href);
const researchActive = research.some((i) => isActive(i.href));
const studentsActive = path.startsWith("/student-opportunities/");
---

<header class="sticky top-0 z-40 bg-pine-900 text-white shadow-md">
  <nav class="mx-auto flex h-16 max-w-6xl items-center justify-between gap-4 px-4">
    <a href="/" class="flex min-w-0 items-center gap-3 shrink-0">
      <Image src={wordmark} alt="Northern Arizona University" class="h-6 w-auto sm:h-7" width={314} height={28} />
      <span class="hidden h-8 w-px bg-pine-400/50 sm:block" aria-hidden="true"></span>
      <span class="font-serif text-[13px] font-semibold leading-snug text-white sm:text-sm">
        School of Earth<br />&amp; Sustainability
      </span>
    </a>

    <!-- Desktop menu -->
    <ul class="hidden lg:flex items-center gap-0.5 text-sm font-medium">
      <li><a href="/" class:list={["nav-link", isActive("/") && "nav-active"]}>Home</a></li>
      <li class="group relative">
        <button
          class:list={["nav-link nav-btn", researchActive && "nav-active"]}
          aria-haspopup="true"
          aria-expanded="false"
        >
          Research
          <svg class="chevron" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 4.5L6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <ul class="dropdown">
          {research.map((i) => (
            <li><a href={i.href} class:list={["dropdown-link", isActive(i.href) && "dropdown-active"]}>{i.name}</a></li>
          ))}
        </ul>
      </li>
      <li><a href="/faculty-profiles/" class:list={["nav-link", isActive("/faculty-profiles/") && "nav-active"]}>Faculty</a></li>
      <li><a href="/news/" class:list={["nav-link", isActive("/news/") && "nav-active"]}>News</a></li>
      <li class="group relative">
        <button
          class:list={["nav-link nav-btn", studentsActive && "nav-active"]}
          aria-haspopup="true"
          aria-expanded="false"
        >
          Students
          <svg class="chevron" viewBox="0 0 12 12" fill="none" aria-hidden="true">
            <path d="M2.5 4.5L6 8l3.5-3.5" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round" />
          </svg>
        </button>
        <ul class="dropdown">
          {opportunities.map((i) => (
            <li><a href={i.href} class:list={["dropdown-link", path === i.href && "dropdown-active"]}>{i.name}</a></li>
          ))}
        </ul>
      </li>
      <li><a href="/alumni/" class:list={["nav-link", isActive("/alumni/") && "nav-active"]}>Alumni</a></li>
      <li><a href="/contact/" class:list={["nav-link", isActive("/contact/") && "nav-active"]}>Contact</a></li>
    </ul>

    <!-- Mobile toggle -->
    <button id="menu-toggle" class="lg:hidden p-2" aria-label="Open menu" aria-expanded="false">
      <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
        <path d="M4 6h16M4 12h16M4 18h16" />
      </svg>
    </button>
  </nav>

  <!-- Mobile menu -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-pine-700 bg-pine-900 px-4 pb-4 text-sm">
    <a href="/" class="mobile-link">Home</a>
    <p class="mobile-heading">Research</p>
    {research.map((i) => <a href={i.href} class="mobile-link pl-4">{i.name}</a>)}
    <a href="/faculty-profiles/" class="mobile-link">Faculty</a>
    <a href="/news/" class="mobile-link">News</a>
    <p class="mobile-heading">Student Opportunities</p>
    {opportunities.map((i) => <a href={i.href} class="mobile-link pl-4">{i.name}</a>)}
    <a href="/alumni/" class="mobile-link">Alumni</a>
    <a href="/contact/" class="mobile-link">Contact</a>
  </div>
</header>

<script>
  const toggle = document.getElementById("menu-toggle");
  const menu = document.getElementById("mobile-menu");
  toggle?.addEventListener("click", () => {
    const open = menu?.classList.toggle("hidden") === false;
    toggle.setAttribute("aria-expanded", String(open));
  });
</script>

<style>
  @reference "../styles/global.css";
  .nav-link {
    @apply flex items-center rounded-md px-3 py-2 text-pine-100 transition-colors hover:bg-pine-800 hover:text-white;
  }
  .nav-btn {
    @apply gap-1.5;
  }
  .chevron {
    @apply h-3 w-3 opacity-70 transition-transform duration-150 group-hover:rotate-180;
  }
  .nav-active {
    @apply bg-pine-800 text-gold-400;
  }
  .dropdown {
    @apply invisible absolute left-0 top-full z-50 mt-1 min-w-56 translate-y-1 rounded-xl border border-slate-200 bg-white py-2 text-slate-700 opacity-0 shadow-xl transition-[opacity,transform] duration-150 group-hover:visible group-hover:translate-y-0 group-hover:opacity-100 group-focus-within:visible group-focus-within:translate-y-0 group-focus-within:opacity-100;
  }
  /* invisible hover bridge so the mt-1 gap doesn't close the menu */
  .dropdown::before {
    content: "";
    position: absolute;
    inset: -0.35rem 0 auto 0;
    height: 0.35rem;
  }
  .dropdown-link {
    @apply block px-4 py-2 hover:bg-pine-50 hover:text-pine-900;
  }
  .dropdown-active {
    @apply font-semibold text-pine-800;
  }
  .mobile-link {
    @apply block py-2 text-pine-100 hover:text-white;
  }
  .mobile-heading {
    @apply pt-3 pb-1 text-xs font-semibold uppercase tracking-wide text-pine-300;
  }
</style>
