---
/**
 * Build-time horizontal ranked bar chart (single series): top journals.
 * Single series, so no legend; every bar carries its value at the data end
 * (a ranking chart's values are the point of the chart).
 */
interface Props {
  title: string;
  ariaLabel: string;
  data: { label: string; value: number }[];
}
const { title, ariaLabel, data } = Astro.props;

const COLOR = "#1c6cae";
const ROW = 34;
const W = 720;
const M = { top: 4, right: 44, bottom: 4, left: 4 };
const H = M.top + M.bottom + data.length * ROW;
const iw = W - M.left - M.right;
const maxV = Math.max(...data.map((d) => d.value), 1);
const barH = 12;

function bar(py: number, w: number) {
  const r = Math.min(4, w, barH / 2);
  return `M${M.left},${py} H${M.left + w - r} Q${M.left + w},${py} ${M.left + w},${py + r} V${py + barH - r} Q${M.left + w},${py + barH} ${M.left + w - r},${py + barH} H${M.left} Z`;
}
---

<figure class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <figcaption class="font-semibold text-pine-900">{title}</figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={ariaLabel} class="mt-3 w-full">
    {data.map((d, i) => {
      const yTop = M.top + i * ROW;
      const w = Math.max(3, (d.value / maxV) * iw);
      return (
        <g data-tip={`${d.label}: ${d.value.toLocaleString("en-US")} publications`}>
          <text x={M.left} y={yTop + 10} font-size="11" fill="#43536a">
            {d.label.length > 72 ? d.label.slice(0, 70) + "…" : d.label}
          </text>
          <path d={bar(yTop + 14, w)} fill={COLOR} />
          <text x={M.left + w + 6} y={yTop + 14 + barH - 2} font-size="10" font-weight="600" fill="#43536a">
            {d.value.toLocaleString("en-US")}
          </text>
        </g>
      );
    })}
  </svg>
</figure>
