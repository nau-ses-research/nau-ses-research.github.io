---
/** One publication in a server-rendered list (profile pages, news). */
import { getFacultyRecords, type Publication } from "../lib/publications";

interface Props {
  pub: Publication;
}
const { pub } = Astro.props;

const facultyByLabel = new Map(getFacultyRecords().map((r) => [r.label, r]));
const facAuthors = pub.ses_faculty.map((label) => {
  const rec = facultyByLabel.get(label);
  const name = rec && rec.first_name ? `${rec.first_name} ${rec.last_name}` : label;
  const url =
    rec?.profile === "current"
      ? `/faculty-profiles/${rec.slug}/`
      : rec?.profile === "archived"
        ? `/archived-profiles/${rec.slug}/`
        : undefined;
  return { name, url };
});
const scholarUrl = pub.doi
  ? `https://doi.org/${pub.doi}`
  : pub.pubid
    ? `https://scholar.google.com/citations?view_op=view_citation&citation_for_view=${pub.pubid}`
    : undefined;
---

<article class="border-b border-slate-100 py-4">
  <h3 class="font-medium text-slate-900">
    {scholarUrl ? (
      <a href={scholarUrl} class="hover:text-pine-700 hover:underline">{pub.title}</a>
    ) : (
      pub.title
    )}
  </h3>
  <p class="mt-1 text-sm text-slate-600">{pub.authors}</p>
  <p class="mt-1 text-sm">
    <span class="italic text-slate-700">{pub.journal}</span>
    {pub.year && <span class="text-slate-500"> · {pub.year}</span>}
    {pub.citations > 0 && (
      <span class="text-slate-500">
        {" "}· {pub.citations.toLocaleString()} {pub.citations === 1 ? "citation" : "citations"}
      </span>
    )}
  </p>
  {(pub.ses_grad_students.length > 0 || pub.ses_undergrad_students.length > 0 || facAuthors.length > 0) && (
    <p class="mt-1.5 flex flex-wrap items-center gap-1.5">
      {(pub.ses_grad_students.length > 0 || pub.ses_undergrad_students.length > 0) && (
        <>
          <span class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Students</span>
          {[...pub.ses_grad_students, ...pub.ses_undergrad_students].map((n) => (
            <span class="rounded-full bg-pine-50 px-2 py-0.5 text-xs text-pine-700">{n}</span>
          ))}
        </>
      )}
      {facAuthors.length > 0 && (
        <>
          <span class="text-[10px] font-semibold uppercase tracking-wide text-slate-400">Faculty</span>
          {facAuthors.map((f) =>
            f.url ? (
              <a href={f.url} class="rounded-full bg-gold-50 px-2 py-0.5 text-xs text-gold-700 hover:bg-gold-300/40">
                {f.name}
              </a>
            ) : (
              <span class="rounded-full bg-gold-50 px-2 py-0.5 text-xs text-gold-700">{f.name}</span>
            ),
          )}
        </>
      )}
    </p>
  )}
</article>
