---
/**
 * Build-time SVG bar chart (single or 2-series stacked).
 * Marks follow the dataviz spec: 2px gaps between bars and stacked segments,
 * 4px rounded data-end on the top segment, recessive grid, selective direct
 * labels (peak + latest), legend for 2 series, per-bar hover tooltip
 * (driven by the shared [data-tip] script on the page), table fallback.
 */
interface Props {
  title: string;
  ariaLabel: string;
  labels: (string | number)[];
  /** one array per series, same length as labels */
  series: number[][];
  seriesNames: string[];
  /** stack series (series[1] drawn on top of series[0]) */
  stacked?: boolean;
  valueFormat?: (n: number) => string;
}
const {
  title,
  ariaLabel,
  labels,
  series,
  seriesNames,
  stacked = false,
  valueFormat = (n: number) => n.toLocaleString("en-US"),
} = Astro.props;

const COLORS = ["#1c6cae", "#c07f0e"]; // validated 2-series palette
const W = 720;
const H = 260;
const M = { top: 18, right: 8, bottom: 26, left: 44 };
const iw = W - M.left - M.right;
const ih = H - M.top - M.bottom;

const totals = labels.map((_, i) =>
  stacked ? series.reduce((s, arr) => s + arr[i], 0) : Math.max(...series.map((arr) => arr[i])),
);
const maxV = Math.max(...totals, 1);
// round the axis max up to a clean step
const step = Math.pow(10, Math.floor(Math.log10(maxV)));
const axisMax = Math.ceil(maxV / (step / 2)) * (step / 2);
const ticks = [0, 0.25, 0.5, 0.75, 1].map((f) => Math.round(axisMax * f));

const n = labels.length;
const slot = iw / n;
const barW = Math.max(4, Math.min(28, slot - 2)); // 2px gap between bars
const x = (i: number) => M.left + i * slot + (slot - barW) / 2;
const y = (v: number) => M.top + ih - (v / axisMax) * ih;
const hgt = (v: number) => (v / axisMax) * ih;

// selective direct labels: the peak bar and the latest bar
const peakIdx = totals.indexOf(Math.max(...totals));
const lastIdx = n - 1;
const labelIdx = new Set([peakIdx, lastIdx]);

/** rounded-top bar path (4px radius at the data end, flat baseline) */
function topBar(px: number, pv: number, ph: number) {
  const r = Math.min(4, ph, barW / 2);
  return `M${px},${pv + ph} V${pv + r} Q${px},${pv} ${px + r},${pv} H${px + barW - r} Q${px + barW},${pv} ${px + barW},${pv + r} V${pv + ph} Z`;
}

const showLegend = series.length > 1;
---

<figure class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm">
  <figcaption class="flex flex-wrap items-baseline justify-between gap-2">
    <span class="font-semibold text-pine-900">{title}</span>
    {showLegend && (
      <span class="flex gap-4 text-xs text-slate-600">
        {seriesNames.map((s, si) => (
          <span class="flex items-center gap-1.5">
            <span class="inline-block h-2.5 w-2.5 rounded-sm" style={`background:${COLORS[si]}`}></span>
            {s}
          </span>
        ))}
      </span>
    )}
  </figcaption>
  <svg viewBox={`0 0 ${W} ${H}`} role="img" aria-label={ariaLabel} class="mt-3 w-full">
    {ticks.map((t) => (
      <g>
        <line
          x1={M.left}
          x2={W - M.right}
          y1={y(t)}
          y2={y(t)}
          stroke={t === 0 ? "#cbd5e1" : "#eef2f6"}
          stroke-width="1"
        />
        <text x={M.left - 6} y={y(t) + 3} text-anchor="end" font-size="10" fill="#7d8a99">
          {valueFormat(t)}
        </text>
      </g>
    ))}
    {labels.map((lab, i) => {
      const isEdge = i === 0 || i === n - 1 || (n > 10 ? i % Math.ceil(n / 8) === 0 : true);
      return (
        <g>
          {stacked ? (
            <>
              {/* base segment */}
              {series[0][i] > 0 && series[1][i] > 0 && (
                <rect x={x(i)} y={y(series[0][i])} width={barW} height={Math.max(0, hgt(series[0][i]) - 1)} fill={COLORS[0]} />
              )}
              {series[0][i] > 0 && series[1][i] === 0 && (
                <path d={topBar(x(i), y(series[0][i]), hgt(series[0][i]))} fill={COLORS[0]} />
              )}
              {/* top segment with 2px surface gap below */}
              {series[1][i] > 0 && (
                <path
                  d={topBar(x(i), y(series[0][i] + series[1][i]), Math.max(1, hgt(series[1][i]) - 1))}
                  fill={COLORS[1]}
                />
              )}
            </>
          ) : (
            series[0][i] > 0 && <path d={topBar(x(i), y(series[0][i]), hgt(series[0][i]))} fill={COLORS[0]} />
          )}
          {/* hover target + tooltip data */}
          <rect
            x={M.left + i * slot}
            y={M.top}
            width={slot}
            height={ih}
            fill="transparent"
            data-tip={
              stacked
                ? `${lab}: ${valueFormat(totals[i])} total · ${valueFormat(series[1][i])} ${seriesNames[1].toLowerCase()}`
                : `${lab}: ${valueFormat(series[0][i])} ${seriesNames[0].toLowerCase()}`
            }
          />
          {labelIdx.has(i) && totals[i] > 0 && (
            <text x={x(i) + barW / 2} y={y(totals[i]) - 5} text-anchor="middle" font-size="10" font-weight="600" fill="#43536a">
              {valueFormat(totals[i])}
            </text>
          )}
          {isEdge && (
            <text x={x(i) + barW / 2} y={H - 8} text-anchor="middle" font-size="10" fill="#7d8a99">
              {lab}
            </text>
          )}
        </g>
      );
    })}
  </svg>
  <details class="mt-2 text-xs text-slate-500">
    <summary class="cursor-pointer hover:text-pine-700">View as table</summary>
    <table class="mt-2 w-full">
      <thead>
        <tr>
          <th class="px-2 py-1 text-left font-semibold">Year</th>
          {seriesNames.map((s) => (
            <th class="px-2 py-1 text-right font-semibold">{s}</th>
          ))}
        </tr>
      </thead>
      <tbody>
        {labels.map((lab, i) => (
          <tr class="border-t border-slate-100">
            <td class="px-2 py-1">{lab}</td>
            {series.map((arr) => (
              <td class="px-2 py-1 text-right">{valueFormat(arr[i])}</td>
            ))}
          </tr>
        ))}
      </tbody>
    </table>
  </details>
</figure>
