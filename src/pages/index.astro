---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import AnnouncementBanner from "../components/AnnouncementBanner.astro";
import { getPublications, studentFirstAuthor } from "../lib/publications";
import { getUpcomingEvents, fmtEventDate } from "../lib/events";
import heroImg from "../assets/media/place/hero-mogollon-rim.jpg";
import undergradImg from "../assets/media/undergraduate-field-experience.jpg";
import gradImg from "../assets/media/graduate-research.jpg";
import researchImg from "../assets/media/core-processing.jpg";
import canyonRiverImg from "../assets/media/place/grand-canyon-river.jpg";
import sedonaClassImg from "../assets/media/place/sedona-class.jpg";
import streamEcologyImg from "../assets/media/place/stream-ecology.jpg";
import dunesImg from "../assets/media/place/death-valley-dunes.jpg";
import pinesSnowImg from "../assets/media/place/pines-and-snow.jpg";
import ugProgramsImg from "../assets/media/coders.jpg";
import gradProgramsImg from "../assets/media/graduate-graduation.jpg";
import certProgramsImg from "../assets/media/climate-science-work.jpg";

const themeImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/themes/*/featured.{jpg,jpeg,png}",
);
async function themeImageFor(id: string) {
  const key = Object.keys(themeImages).find((k) => k.includes(`/${id}/`));
  return key ? (await themeImages[key]()).default : undefined;
}
const themes = (await getCollection("themes")).sort(
  (a, b) => a.data.weight - b.data.weight || a.data.title.localeCompare(b.data.title),
);
const newsImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/news/*/featured.{jpg,jpeg,png,webp}",
);
async function newsImageFor(id: string) {
  const key = Object.keys(newsImages).find((k) => k.includes(`/${id}/`));
  return key ? (await newsImages[key]()).default : undefined;
}
const news = (await getCollection("news"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const newsCards = await Promise.all(
  news.map(async (entry) => ({ entry, image: await newsImageFor(entry.id) })),
);

// The pulse: what's new this week, derived at build time.
// Within a batch of same-day additions, student-led papers come first,
// then papers with any student author, then citations break remaining ties.
const allPubs = getPublications();
const studentRank = (p: (typeof allPubs)[number]) =>
  studentFirstAuthor(p) ? 0 : p.ses_grad_students.length + p.ses_undergrad_students.length > 0 ? 1 : 2;
const latestPubs = [...allPubs]
  .sort(
    (a, b) =>
      b.date_added.localeCompare(a.date_added) ||
      studentRank(a) - studentRank(b) ||
      b.citations - a.citations ||
      (b.year ?? 0) - (a.year ?? 0),
  )
  .slice(0, 3);
const upcoming = await getUpcomingEvents(3);

const programs = [
  {
    name: "Undergraduate Degrees",
    href: "/student-opportunities/undergraduate-degrees/",
    text: "Comprehensive programs in Geology, Environmental Sciences, and Sustainability Studies preparing students for professional careers.",
    image: ugProgramsImg,
  },
  {
    name: "Graduate Degrees",
    href: "/student-opportunities/graduate-degrees/",
    text: "Advanced research programs including Master's and PhD options in cutting-edge Earth and environmental sciences.",
    image: gradProgramsImg,
  },
  {
    name: "Certificate Programs",
    href: "/student-opportunities/",
    text: "Specialized training for career advancement in high-demand environmental and sustainability fields.",
    image: certProgramsImg,
  },
];
---

<Base title="Home">
  <AnnouncementBanner />
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-pine-950 text-white">
    <Image
      src={heroImg}
      alt=""
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-70"
      width={1920}
      loading="eager"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-r from-pine-950/90 via-pine-950/65 to-pine-950/25"></div>
    <div class="mx-auto max-w-6xl px-4 py-24 sm:py-32">
      <p class="text-sm font-semibold uppercase tracking-widest text-gold-400">
        Northern Arizona University
      </p>
      <h1 class="mt-3 max-w-3xl font-serif text-4xl font-bold leading-tight sm:text-5xl">
        School of Earth and Sustainability
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pine-100">
        We are dedicated to understanding Earth's complex systems and fostering sustainable
        solutions for our planet's future. Through innovative research, hands-on education, and
        community engagement, we prepare the next generation of Earth scientists and sustainability
        leaders.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/student-opportunities/"
          class="rounded-lg bg-gold-400 px-5 py-2.5 font-semibold text-pine-950 hover:bg-gold-300"
        >
          Explore our programs
        </a>
        <a
          href="/research/"
          class="rounded-lg border border-pine-300/60 px-5 py-2.5 font-medium text-white hover:bg-pine-800"
        >
          See our research impact
        </a>
      </div>
    </div>
  </section>

  <!-- Audience doorways -->
  <section class="relative z-10 mx-auto -mt-12 max-w-6xl px-4 pb-4">
    <div class="grid gap-5 md:grid-cols-3">
      <a
        href="/student-opportunities/"
        class="group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-md transition hover:-translate-y-0.5 hover:shadow-lg"
      >
        <Image
          src={undergradImg}
          alt="Undergraduates on a field trip in the high desert"
          width={800}
          height={480}
          class="aspect-[5/3] w-full object-cover transition group-hover:scale-[1.02]"
        />
        <div class="p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-700">Future Students</p>
          <h2 class="mt-2 font-serif text-xl font-semibold text-pine-900 group-hover:text-pine-700">
            Find your program
          </h2>
          <p class="mt-2 text-sm text-slate-600">
            Degrees and certificates in geology, environmental sciences, climate, and
            sustainability, from bachelor's to PhD. Meet our students on video and see where our
            alumni land.
          </p>
          <p class="mt-3 text-sm font-medium text-gold-700 group-hover:text-gold-600">
            Explore programs →
          </p>
        </div>
      </a>
      <a
        href="/current-students/"
        class="group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-md transition hover:-translate-y-0.5 hover:shadow-lg"
      >
        <Image
          src={gradImg}
          alt="Graduate student doing research"
          width={800}
          height={480}
          class="aspect-[5/3] w-full object-cover transition group-hover:scale-[1.02]"
        />
        <div class="p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-700">Current Students</p>
          <h2 class="mt-2 font-serif text-xl font-semibold text-pine-900 group-hover:text-pine-700">
            Grad student resources
          </h2>
          <p class="mt-2 text-sm text-slate-600">
            Handbooks, course planning, thesis and defense procedures, the events calendar,
            scholarships, and the people who can help.
          </p>
          <p class="mt-3 text-sm font-medium text-gold-700 group-hover:text-gold-600">
            Get what you need →
          </p>
        </div>
      </a>
      <a
        href="/research/"
        class="group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-md transition hover:-translate-y-0.5 hover:shadow-lg"
      >
        <Image
          src={researchImg}
          alt="Researchers processing a fresh sediment core on a mountain lakeshore"
          width={800}
          height={480}
          class="aspect-[5/3] w-full object-cover transition group-hover:scale-[1.02]"
        />
        <div class="p-6">
          <p class="text-xs font-semibold uppercase tracking-widest text-gold-700">Our Research</p>
          <h2 class="mt-2 font-serif text-xl font-semibold text-pine-900 group-hover:text-pine-700">
            Research that matters
          </h2>
          <p class="mt-2 text-sm text-slate-600">
            Explore a decade and a half of SES science: every publication, citation trends, and
            the themes that organize our work, updated weekly.
          </p>
          <p class="mt-3 text-sm font-medium text-gold-700 group-hover:text-gold-600">
            See our impact →
          </p>
        </div>
      </a>
    </div>
  </section>

  <!-- The pulse: fresh from SES, derived at build time -->
  <section class="bg-sand-50">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <div class="flex items-baseline justify-between">
        <h2 class="font-serif text-2xl font-bold text-pine-900">This week at SES</h2>
        <p class="text-xs text-slate-600">Updated with every weekly data refresh</p>
      </div>
      <div class="mt-6 grid gap-6 lg:grid-cols-3">
        <div class:list={["rounded-xl border border-slate-200 bg-white p-5 shadow-sm", upcoming.length === 0 && "lg:col-span-1"]}>
          <h3 class="text-xs font-semibold uppercase tracking-widest text-gold-700">Upcoming events</h3>
          {upcoming.length > 0 ? (
            <ul class="mt-3 space-y-3">
              {upcoming.map((e) => (
                <li class="text-sm">
                  <span class="font-mono text-xs text-pine-600">{fmtEventDate(e)}</span>
                  <span class="block font-medium text-slate-800">{e.title}</span>
                  {e.location && <span class="block text-xs text-slate-500">{e.location}</span>}
                </li>
              ))}
            </ul>
          ) : (
            <p class="mt-3 text-sm text-slate-500">
              Nothing scheduled right now; see the
              <a href="/current-students/calendar-seminars/" class="text-pine-600 underline decoration-gold-400 decoration-2 underline-offset-2">full calendar</a>.
            </p>
          )}
          <a href="/current-students/calendar-seminars/" class="mt-3 inline-block text-sm font-medium text-pine-600 hover:text-pine-800">
            Calendar &amp; seminars →
          </a>
        </div>
        <div class="rounded-xl border border-slate-200 bg-white p-5 shadow-sm lg:col-span-2">
          <h3 class="text-xs font-semibold uppercase tracking-widest text-gold-700">Newest publications</h3>
          <ul class="mt-3 space-y-3">
            {latestPubs.map((p) => (
              <li class="text-sm">
                <span class="block font-medium text-slate-800">
                  {p.doi ? <a href={`https://doi.org/${p.doi}`} class="hover:text-pine-700 hover:underline">{p.title}</a> : p.title}
                </span>
                <span class="text-xs text-slate-500">
                  <em>{p.journal}</em>{p.year && ` · ${p.year}`}
                  {p.ses_grad_students.length > 0 && ` · student author: ${p.ses_grad_students.join(", ")}`}
                </span>
              </li>
            ))}
          </ul>
          <a href="/publications/" class="mt-3 inline-block text-sm font-medium text-pine-600 hover:text-pine-800">
            All publications →
          </a>
        </div>
      </div>
    </div>
  </section>

  <!-- Place: the Colorado Plateau as classroom -->
  <section class="bg-pine-950 text-white">
    <div class="mx-auto grid max-w-6xl items-center gap-10 px-4 py-16 lg:grid-cols-2">
      <div>
        <p class="text-sm font-semibold uppercase tracking-widest text-gold-400">Flagstaff, Arizona</p>
        <h2 class="mt-3 font-serif text-3xl font-bold leading-tight sm:text-4xl">
          Your classroom is the Colorado Plateau
        </h2>
        <p class="mt-4 leading-relaxed text-pine-100">
          We work at 7,000 feet in the world's first International Dark Sky City, at the edge
          of the largest ponderosa pine forest on the continent. The Grand Canyon is a day
          trip. So are Sedona's red rocks, the San Francisco volcanic field, and desert,
          forest, and alpine ecosystems stacked within an hour of campus. Our courses use all
          of it.
        </p>
        <a
          href="/student-opportunities/field-experiences/"
          class="mt-6 inline-block rounded-lg bg-gold-400 px-5 py-2.5 font-semibold text-pine-950 hover:bg-gold-300"
        >
          See where our courses go
        </a>
      </div>
      <Image
        src={canyonRiverImg}
        alt="The Colorado River in the depths of the Grand Canyon"
        width={900}
        class="w-full rounded-xl shadow-lg"
      />
    </div>
    <div class="mx-auto grid max-w-6xl grid-cols-2 gap-3 px-4 pb-16 sm:grid-cols-4">
      <Image src={sedonaClassImg} alt="Geology class on Sedona red rock" width={480} height={360} class="aspect-[4/3] w-full rounded-lg object-cover" />
      <Image src={streamEcologyImg} alt="Students sampling a stream in waders" width={480} height={360} class="aspect-[4/3] w-full rounded-lg object-cover" />
      <Image src={dunesImg} alt="Students climbing dunes at Death Valley" width={480} height={360} class="aspect-[4/3] w-full rounded-lg object-cover" />
      <Image src={pinesSnowImg} alt="Snowy ponderosa pines in Flagstaff" width={480} height={360} class="aspect-[4/3] w-full rounded-lg object-cover" />
    </div>
  </section>

  <!-- Programs -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-center font-serif text-3xl font-bold text-pine-900">Academic Programs</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {programs.map((p) => (
        <a
          href={p.href}
          class="group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md"
        >
          <Image
            src={p.image}
            alt=""
            width={800}
            height={480}
            class="aspect-[5/3] w-full object-cover transition group-hover:scale-[1.02]"
          />
          <span class="block p-6">
            <h3 class="font-serif text-xl font-semibold text-pine-900 group-hover:text-pine-700">
              {p.name}
            </h3>
            <p class="mt-2 text-sm text-slate-600">{p.text}</p>
            <p class="mt-4 text-sm font-medium text-gold-700 group-hover:text-gold-600">Learn more →</p>
          </span>
        </a>
      ))}
    </div>
  </section>

  <!-- Research themes -->
  <section class="bg-pine-50/50">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-center font-serif text-3xl font-bold text-pine-900">Research Themes</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {await Promise.all(
          themes.map(async (t) => {
            const img = await themeImageFor(t.id);
            return (
              <a
                href={`/research-themes/${t.id}/`}
                class="group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md"
              >
                {img && (
                  <Image
                    src={img}
                    alt=""
                    width={640}
                    height={360}
                    class="aspect-video w-full object-cover transition group-hover:scale-[1.02]"
                  />
                )}
                <span class="block p-5">
                  <h3 class="font-serif text-lg font-semibold text-pine-900 group-hover:text-pine-700">
                    {t.data.title}
                  </h3>
                  <p class="mt-2 line-clamp-2 text-sm text-slate-600">{t.data.summary}</p>
                </span>
              </a>
            );
          }),
        )}
      </div>
    </div>
  </section>

  <!-- News -->
  {news.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-16">
      <div class="flex items-baseline justify-between">
        <h2 class="font-serif text-3xl font-bold text-pine-900">Latest News</h2>
        <a href="/news/" class="text-sm font-medium text-pine-600 hover:text-pine-800">All news →</a>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {newsCards.map(({ entry: n, image: img }) => (
          <a
            href={`/news/${n.id}/`}
            class="group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md"
          >
            {img && (
              <Image
                src={img}
                alt={n.data.image_caption ?? ""}
                width={800}
                height={480}
                class="aspect-[5/3] w-full object-cover transition group-hover:scale-[1.02]"
              />
            )}
            <div class="p-5">
              <p class="text-xs uppercase tracking-wide text-slate-500">
                {n.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" })}
              </p>
              <h3 class="mt-2 font-serif text-lg font-semibold text-pine-900 group-hover:text-pine-700">
                {n.data.title}
              </h3>
              <p class="mt-2 line-clamp-3 text-sm text-slate-600">{n.data.summary}</p>
            </div>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Commitment / CTA -->
  <section class="bg-pine-900 text-white">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center">
      <h2 class="font-serif text-3xl font-bold">Our Commitment</h2>
      <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-pine-100">
        We believe that understanding Earth's systems is essential for building a sustainable
        future. Our students work alongside faculty on research that matters, in the field, in the
        lab, and in the communities of the Colorado Plateau and beyond.
      </p>
      <a
        href="https://nau.edu/apply-now/"
        class="mt-8 inline-block rounded-lg bg-gold-400 px-6 py-3 font-semibold text-pine-950 hover:bg-gold-300"
      >
        Apply to NAU
      </a>
    </div>
  </section>
</Base>
