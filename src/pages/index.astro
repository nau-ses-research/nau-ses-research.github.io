---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../layouts/Base.astro";
import StatTile from "../components/StatTile.astro";
import { getStats, fmt } from "../lib/stats";
import heroImg from "../assets/media/home.jpg";

const stats = getStats();
const themes = (await getCollection("themes")).sort(
  (a, b) => a.data.weight - b.data.weight || a.data.title.localeCompare(b.data.title),
);
const news = (await getCollection("news"))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);

const programs = [
  {
    name: "Undergraduate Degrees",
    href: "/student-opportunities/undergraduate-degrees/",
    text: "Comprehensive programs in Geology, Environmental Sciences, and Sustainability Studies preparing students for professional careers.",
  },
  {
    name: "Graduate Degrees",
    href: "/student-opportunities/graduate-degrees/",
    text: "Advanced research programs including Master's and PhD options in cutting-edge Earth and environmental sciences.",
  },
  {
    name: "Certificate Programs",
    href: "/student-opportunities/",
    text: "Specialized training for career advancement in high-demand environmental and sustainability fields.",
  },
];
---

<Base title="Home">
  <!-- Hero -->
  <section class="relative isolate overflow-hidden bg-pine-950 text-white">
    <Image
      src={heroImg}
      alt=""
      class="absolute inset-0 -z-10 h-full w-full object-cover opacity-40"
      width={1920}
      loading="eager"
    />
    <div class="absolute inset-0 -z-10 bg-gradient-to-b from-pine-950/70 to-pine-900/80"></div>
    <div class="mx-auto max-w-6xl px-4 py-24 sm:py-32">
      <p class="text-sm font-semibold uppercase tracking-widest text-gold-400">
        Northern Arizona University
      </p>
      <h1 class="mt-3 max-w-3xl font-serif text-4xl font-bold leading-tight sm:text-5xl">
        School of Earth and Sustainability
      </h1>
      <p class="mt-5 max-w-2xl text-lg leading-relaxed text-pine-100">
        We are dedicated to understanding Earth's complex systems and fostering sustainable
        solutions for our planet's future. Through innovative research, hands-on education, and
        community engagement, we prepare the next generation of Earth scientists and sustainability
        leaders.
      </p>
      <div class="mt-8 flex flex-wrap gap-3">
        <a
          href="/student-opportunities/"
          class="rounded-lg bg-gold-400 px-5 py-2.5 font-semibold text-pine-950 hover:bg-gold-300"
        >
          Explore our programs
        </a>
        <a
          href="/research/"
          class="rounded-lg border border-pine-300/60 px-5 py-2.5 font-medium text-white hover:bg-pine-800"
        >
          See our research impact
        </a>
      </div>
    </div>
  </section>

  <!-- Impact stats -->
  <section class="bg-sand-50">
    <div class="mx-auto max-w-6xl px-4 py-12">
      <div class="grid gap-4 sm:grid-cols-2 lg:grid-cols-4">
        <StatTile value={fmt(stats.totalFacultyPubs)} label="Publications" sub="peer-reviewed, since 2009" />
        <StatTile value={fmt(stats.totalCitations)} label="Citations" sub="to SES faculty research" />
        <StatTile value={String(stats.hIndex)} label="H-index" sub="school-wide, since 2009" />
        <StatTile value={fmt(stats.totalGradStudents)} label="Student authors" sub="grad students publishing" />
      </div>
      <p class="mt-4 text-center text-sm text-slate-500">
        Updated weekly from Google Scholar ·
        <a href="/publications/" class="text-pine-600 underline decoration-gold-400 decoration-2 underline-offset-2">
          browse every publication
        </a>
      </p>
    </div>
  </section>

  <!-- Programs -->
  <section class="mx-auto max-w-6xl px-4 py-16">
    <h2 class="text-center font-serif text-3xl font-bold text-pine-900">Academic Programs</h2>
    <div class="mt-8 grid gap-6 md:grid-cols-3">
      {programs.map((p) => (
        <a
          href={p.href}
          class="group rounded-xl border border-slate-200 bg-white p-6 shadow-sm transition hover:shadow-md"
        >
          <h3 class="font-serif text-xl font-semibold text-pine-900 group-hover:text-pine-700">
            {p.name}
          </h3>
          <p class="mt-2 text-sm text-slate-600">{p.text}</p>
          <p class="mt-4 text-sm font-medium text-gold-600 group-hover:text-gold-500">Learn more →</p>
        </a>
      ))}
    </div>
  </section>

  <!-- Research themes -->
  <section class="bg-pine-50/50">
    <div class="mx-auto max-w-6xl px-4 py-16">
      <h2 class="text-center font-serif text-3xl font-bold text-pine-900">Research Themes</h2>
      <div class="mt-8 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
        {themes.map((t) => (
          <a
            href={`/research-themes/${t.id}/`}
            class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md"
          >
            <h3 class="font-serif text-lg font-semibold text-pine-900 group-hover:text-pine-700">
              {t.data.title}
            </h3>
            <p class="mt-2 line-clamp-2 text-sm text-slate-600">{t.data.summary}</p>
          </a>
        ))}
      </div>
    </div>
  </section>

  <!-- News -->
  {news.length > 0 && (
    <section class="mx-auto max-w-6xl px-4 py-16">
      <div class="flex items-baseline justify-between">
        <h2 class="font-serif text-3xl font-bold text-pine-900">Latest News</h2>
        <a href="/news/" class="text-sm font-medium text-pine-600 hover:text-pine-800">All news →</a>
      </div>
      <div class="mt-8 grid gap-6 md:grid-cols-3">
        {news.map((n) => (
          <a
            href={`/news/${n.id}/`}
            class="group rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md"
          >
            <p class="text-xs uppercase tracking-wide text-slate-500">
              {n.data.date.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric" })}
            </p>
            <h3 class="mt-2 font-serif text-lg font-semibold text-pine-900 group-hover:text-pine-700">
              {n.data.title}
            </h3>
            <p class="mt-2 line-clamp-3 text-sm text-slate-600">{n.data.summary}</p>
          </a>
        ))}
      </div>
    </section>
  )}

  <!-- Commitment / CTA -->
  <section class="bg-pine-900 text-white">
    <div class="mx-auto max-w-4xl px-4 py-16 text-center">
      <h2 class="font-serif text-3xl font-bold">Our Commitment</h2>
      <p class="mx-auto mt-4 max-w-2xl leading-relaxed text-pine-100">
        We believe that understanding Earth's systems is essential for building a sustainable
        future. Our students work alongside faculty on research that matters, in the field, in the
        lab, and in the communities of the Colorado Plateau and beyond.
      </p>
      <a
        href="https://nau.edu/apply-now/"
        class="mt-8 inline-block rounded-lg bg-gold-400 px-6 py-3 font-semibold text-pine-950 hover:bg-gold-300"
      >
        Apply to NAU
      </a>
    </div>
  </section>
</Base>
