---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import VideoGrid from "../../components/VideoGrid.astro";

const videos = [
  { title: "BS in Geology", youtube_id: "ZXtzmhcfcgM" },
  { title: "BS in Environmental Sciences", youtube_id: "a-O6IL6LEgA" },
  { title: "BS in Environmental & Sustainability Studies", youtube_id: "mkoW-hc7fas" },
];

// The nav-linked opportunity pages (weight < 90); loose program pages
// (geology-ms etc.) are linked from within the degree pages themselves.
const opps = (await getCollection("opportunities"))
  .filter((o) => o.data.weight < 90)
  .sort((a, b) => a.data.weight - b.data.weight);

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/opportunities/*/featured.{jpg,jpeg,png}",
);
function imageFor(id: string) {
  const key = Object.keys(images).find((k) => k.includes(`/${id}/`));
  return key ? images[key]() : undefined;
}
const shortTitle = (t: string) => t.split("|")[0].trim();
---

<Base
  title="Student Opportunities"
  description="Undergraduate and graduate degrees, certificates, and fellowships in earth sciences, environmental sustainability, geology, and climate science at NAU."
>
  <PageHero
    title="Student Opportunities"
    lede="From bachelor's degrees to PhDs, professional certificates to funded fellowships: find your path in earth and sustainability science at NAU."
  />
  <div class="mx-auto max-w-6xl px-4 py-12">
    <section class="mb-12">
      <h2 class="font-serif text-2xl font-semibold text-pine-900">See yourself here</h2>
      <p class="mt-1 mb-4 text-sm text-slate-600">
        Hear from our students and faculty about studying earth and sustainability science at NAU.
      </p>
      <VideoGrid videos={videos} />
    </section>

    <h2 class="mb-6 font-serif text-2xl font-semibold text-pine-900">Degrees, certificates &amp; fellowships</h2>
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {await Promise.all(
        opps.map(async (o) => {
          const img = await imageFor(o.id);
          return (
            <a
              href={`/student-opportunities/${o.id}/`}
              class="group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md"
            >
              {img && (
                <Image
                  src={img.default}
                  alt={shortTitle(o.data.title)}
                  width={640}
                  height={400}
                  class="aspect-[8/5] w-full object-cover transition group-hover:scale-[1.02]"
                />
              )}
              <div class="p-5">
                <h2 class="font-serif text-xl font-semibold text-pine-900 group-hover:text-pine-700">
                  {o.data.nav_title ?? shortTitle(o.data.title)}
                </h2>
                <p class="mt-2 line-clamp-3 text-sm text-slate-600">{o.data.summary}</p>
              </div>
            </a>
          );
        }),
      )}
    </div>
  </div>
</Base>
