---
import { getCollection, getEntry, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../../layouts/Base.astro";
import { PROGRAMS } from "../../../lib/advisors";

export async function getStaticPaths() {
  // Only advisors who have supplied a description get their own page; the rest
  // are fully represented by their card on the index.
  const advisors = (await getCollection("advisors")).filter(
    (a) => (a.body ?? "").trim().length > 0,
  );
  return advisors.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const profile = await getEntry("faculty", entry.data.faculty);
if (!profile) throw new Error(`advisors/${entry.id}: no faculty profile "${entry.data.faculty}"`);

const portraits = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/faculty/*/featured.{jpg,jpeg,png}",
);
const key = Object.keys(portraits).find((k) => k.includes(`/${entry.data.faculty}/`));
const portrait = key ? (await portraits[key]()).default : undefined;
---

<Base
  title={`Graduate positions with ${profile.data.name}`}
  description={entry.data.summary}
>
  <div class="bg-pine-900 py-10">
    <div class="mx-auto max-w-3xl px-4">
      <p class="text-sm text-pine-200">
        <a href="/student-opportunities/find-an-advisor/" class="hover:text-gold-400">
          Find an Advisor
        </a> · Recruiting for {entry.data.cycle}
      </p>
      <div class="mt-3 flex items-center gap-4">
        {portrait && (
          <Image
            src={portrait}
            alt=""
            width={112}
            height={112}
            class="h-20 w-20 shrink-0 rounded-full object-cover object-[50%_25%]"
          />
        )}
        <div>
          <h1 class="font-serif text-3xl font-bold text-white">
            Graduate positions with {profile.data.name}
          </h1>
          {profile.data.title && <p class="mt-1 text-pine-100">{profile.data.title}</p>}
        </div>
      </div>
    </div>
  </div>
  <div class="h-1.5 bg-gold-400"></div>

  <article class="mx-auto max-w-3xl px-4 py-10">
    <dl class="grid gap-4 rounded-xl bg-pine-50 p-5 text-sm sm:grid-cols-2">
      <div>
        <dt class="font-semibold text-pine-900">Programs</dt>
        <dd class="mt-1 space-y-1">
          {entry.data.programs.map((p) => (
            <div>
              <a
                href={PROGRAMS[p].href}
                class="text-pine-700 underline decoration-gold-400 decoration-2 underline-offset-2 hover:text-pine-900"
              >
                {PROGRAMS[p].long}
              </a>
            </div>
          ))}
        </dd>
      </div>
      {entry.data.seeking && (
        <div>
          <dt class="font-semibold text-pine-900">Seeking</dt>
          <dd class="mt-1 text-slate-700">{entry.data.seeking}</dd>
        </div>
      )}
      {entry.data.contact && (
        <div>
          <dt class="font-semibold text-pine-900">Contact</dt>
          <dd class="mt-1">
            <a href={`mailto:${entry.data.contact}`} class="text-pine-700 hover:text-pine-900">
              {entry.data.contact}
            </a>
          </dd>
        </div>
      )}
      {entry.data.apply_by && (
        <div>
          <dt class="font-semibold text-pine-900">To apply</dt>
          <dd class="mt-1 text-slate-700">{entry.data.apply_by}</dd>
        </div>
      )}
    </dl>

    <div class="prose-ses mt-8 max-w-none">
      <Content />
    </div>

    <div class="mt-10 flex flex-wrap gap-x-5 gap-y-2 border-t border-slate-200 pt-5 text-sm">
      <a
        href={`/faculty-profiles/${entry.data.faculty}/`}
        class="text-pine-700 underline decoration-gold-400 decoration-2 underline-offset-2 hover:text-pine-900"
      >
        {profile.data.name}'s profile
      </a>
      {entry.data.links.map((l) => (
        <a href={l.url} class="text-pine-700 hover:text-pine-900" rel="noopener">{l.label} ↗</a>
      ))}
      <a href="/student-opportunities/find-an-advisor/" class="text-pine-700 hover:text-pine-900">
        All recruiting advisors
      </a>
    </div>
  </article>
</Base>
