---
import { getCollection, getEntry } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";

const page = await getEntry("opportunities", "undergraduate-degrees");
const opps = await getCollection("opportunities");

// The four undergraduate programs, in display order
const programIds = [
  "geology-bs",
  "environmental-sciences-bs",
  "environmental-sustainability-studies-bs",
  "earth-science-bsed",
];
const programs = programIds
  .map((id) => opps.find((o) => o.id === id))
  .filter((o) => o !== undefined);

const photos = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/opportunities/*/featured.{jpg,jpeg,png}",
);
async function photoFor(id: string) {
  const key = Object.keys(photos).find((k) => k.includes(`/${id}/`));
  return key ? (await photos[key]()).default : undefined;
}
---

<Base title="Undergraduate Degree Programs" description={page!.data.summary}>
  <PageHero
    title="Undergraduate Degree Programs"
    lede="Four paths into earth and sustainability science: hands-on, field-based programs that prepare you for professional careers, teaching, and graduate study."
  />

  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-8 sm:grid-cols-2">
      {await Promise.all(
        programs.map(async (p) => {
          const video = p!.data.videos[0];
          const photo = await photoFor(p!.id);
          const shortTitle = p!.data.title.split("|")[0].trim();
          return (
            <a
              href={`/student-opportunities/${p!.id}/`}
              class="group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:-translate-y-0.5 hover:shadow-md"
            >
              <span class="relative block">
                {video ? (
                  <img
                    src={`https://img.youtube.com/vi/${video.youtube_id}/hqdefault.jpg`}
                    alt=""
                    width="480"
                    height="360"
                    loading="lazy"
                    class="aspect-video w-full object-cover transition group-hover:scale-[1.02]"
                  />
                ) : (
                  photo && (
                    <Image
                      src={photo}
                      alt=""
                      width={800}
                      height={450}
                      class="aspect-video w-full object-cover transition group-hover:scale-[1.02]"
                    />
                  )
                )}
                {video && (
                  <span class="absolute inset-0 flex items-center justify-center bg-pine-950/20 transition group-hover:bg-pine-950/10">
                    <span class="flex h-14 w-14 items-center justify-center rounded-full bg-pine-950/70 shadow-lg transition group-hover:bg-pine-900">
                      <svg class="ml-1 h-6 w-6 text-white" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
                        <path d="M8 5.5v13l11-6.5z" />
                      </svg>
                    </span>
                  </span>
                )}
              </span>
              <span class="block p-6">
                <span class="block font-serif text-xl font-semibold text-pine-900 group-hover:text-pine-700">
                  {shortTitle}
                </span>
                <span class="mt-2 block text-sm text-slate-600">{p!.data.summary}</span>
                <span class="mt-3 block text-sm font-medium text-gold-600 group-hover:text-gold-500">
                  {video ? "Program details & video →" : "Program details →"}
                </span>
              </span>
            </a>
          );
        }),
      )}
    </div>

    <section class="mt-14 grid gap-10 lg:grid-cols-2">
      <div>
        <h2 class="font-serif text-2xl font-semibold text-pine-900">Applying to NAU</h2>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-slate-700">
          <li>High school diploma or equivalent</li>
          <li>Satisfactory SAT or ACT scores</li>
          <li>Completed application to Northern Arizona University</li>
          <li>Official transcripts from all previous institutions</li>
        </ul>
        <a
          href="https://nau.edu/apply/"
          class="mt-5 inline-block rounded-lg bg-gold-400 px-5 py-2.5 font-semibold text-pine-950 hover:bg-gold-300"
        >
          Apply to NAU
        </a>
      </div>
      <div>
        <h2 class="font-serif text-2xl font-semibold text-pine-900">Support along the way</h2>
        <ul class="mt-3 list-disc space-y-1 pl-5 text-sm text-slate-700">
          <li>Professional academic advisors</li>
          <li>Faculty mentorship programs</li>
          <li>Career counseling services</li>
          <li>Graduate school preparation guidance</li>
        </ul>
        <p class="mt-5 text-sm text-slate-700">
          Questions? Email
          <a href="mailto:SES.Admin@nau.edu" class="text-pine-600 underline decoration-gold-400 decoration-2 underline-offset-2">SES.Admin@nau.edu</a>
          or call 928-523-9333 · Room A108, Building 11, Ashurst
        </p>
      </div>
    </section>
  </div>
</Base>
