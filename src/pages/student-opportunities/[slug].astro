---
import { getCollection, render } from "astro:content";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import VideoGrid from "../../components/VideoGrid.astro";

export async function getStaticPaths() {
  const opps = await getCollection("opportunities");
  // undergraduate-degrees has a dedicated tile-based route
  return opps
    .filter((entry) => entry.id !== "undergraduate-degrees")
    .map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const shortTitle = entry.data.title.split("|")[0].trim();
const video = entry.data.videos.length === 1 ? entry.data.videos[0] : undefined;

const programJsonLd = {
  "@context": "https://schema.org",
  "@type": "EducationalOccupationalProgram",
  name: shortTitle,
  description: entry.data.summary,
  provider: {
    "@type": "CollegeOrUniversity",
    name: "School of Earth and Sustainability, Northern Arizona University",
    url: "https://ses-nau.org/",
  },
  url: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Base
  title={shortTitle}
  description={entry.data.summary}
  jsonLd={programJsonLd}
  ogImage={video ? `https://img.youtube.com/vi/${video.youtube_id}/hqdefault.jpg` : undefined}
>
  <PageHero title={shortTitle} lede={entry.data.summary} />
  {video && (
    <div class="bg-pine-950">
      <div class="mx-auto max-w-5xl px-4 py-10">
        <iframe
          id="program-video"
          class="aspect-video w-full rounded-xl shadow-2xl"
          src={`https://www.youtube-nocookie.com/embed/${video.youtube_id}?enablejsapi=1`}
          title={video.title}
          allow="accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
          allowfullscreen
        />
      </div>
      <script is:inline>
        (function () {
          var iframe = document.getElementById("program-video");
          if (!iframe) return;
          var tag = document.createElement("script");
          tag.src = "https://www.youtube.com/iframe_api";
          document.head.appendChild(tag);
          var fired = false;
          window.onYouTubeIframeAPIReady = function () {
            new YT.Player(iframe, {
              events: {
                onStateChange: function (ev) {
                  if (ev.data === YT.PlayerState.PLAYING && !fired) {
                    fired = true;
                    if (typeof gtag === "function") {
                      gtag("event", "video_play", {
                        video_title: iframe.title,
                        page_path: location.pathname,
                      });
                    }
                  }
                },
              },
            });
          };
        })();
      </script>
    </div>
  )}
  <div class="mx-auto max-w-4xl px-4 py-10">
    {entry.data.videos.length > 1 && (
      <section class="mb-10">
        <h2 class="font-serif text-2xl font-semibold text-pine-900">
          Meet our programs
        </h2>
        <p class="mt-1 mb-4 text-sm text-slate-600">
          Hear from our students and faculty about what it's like to study here.
        </p>
        <VideoGrid videos={entry.data.videos} />
      </section>
    )}
    <div class="prose-ses max-w-none">
      <Content />
    </div>
    <p class="mt-10">
      <a href="/student-opportunities/" class="text-pine-600 underline decoration-gold-400 decoration-2 underline-offset-2 hover:text-pine-800">
        ← All student opportunities
      </a>
    </p>
  </div>
</Base>
