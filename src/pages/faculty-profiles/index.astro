---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";

const faculty = (await getCollection("faculty")).sort((a, b) =>
  a.data.last_name.localeCompare(b.data.last_name),
);

const portraits = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/faculty/*/featured.{jpg,jpeg,png}",
);
function portraitFor(id: string) {
  const key = Object.keys(portraits).find((k) => k.includes(`/${id}/`));
  return key ? portraits[key]() : undefined;
}
---

<Base
  title="Faculty Profiles"
  description="Meet the faculty of NAU's School of Earth and Sustainability: researchers in geology, climate science, ecology, conservation, hydrology, and environmental policy."
>
  <PageHero
    title="Faculty"
    lede="Our faculty lead research across earth sciences, climate, ecology, water, and environmental policy, and mentor the next generation of scientists and sustainability leaders."
  />
  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="grid gap-8 sm:grid-cols-2 lg:grid-cols-3">
      {await Promise.all(
        faculty.map(async (f) => {
          const slug = f.id;
          const img = await portraitFor(f.id);
          return (
            <a
              href={`/faculty-profiles/${slug}/`}
              class="group overflow-hidden rounded-xl border border-slate-200 bg-white shadow-sm transition hover:shadow-md"
            >
              {img && (
                <Image
                  src={img.default}
                  alt={f.data.name}
                  width={640}
                  height={640}
                  class="aspect-square w-full object-cover object-[50%_25%] transition group-hover:scale-[1.02]"
                />
              )}
              <div class="p-5">
                <h2 class="font-serif text-xl font-semibold text-pine-900 group-hover:text-pine-700">
                  {f.data.name}
                </h2>
                {f.data.summary && (
                  <p class="mt-2 line-clamp-3 text-sm text-slate-600">{f.data.summary}</p>
                )}
                {f.data.interests.length > 0 && (
                  <p class="mt-3 flex flex-wrap gap-1.5">
                    {f.data.interests.slice(0, 3).map((t) => (
                      <span class="rounded-full bg-pine-50 px-2.5 py-0.5 text-xs text-pine-700">
                        {t}
                      </span>
                    ))}
                  </p>
                )}
              </div>
            </a>
          );
        }),
      )}
    </div>
  </div>
</Base>
