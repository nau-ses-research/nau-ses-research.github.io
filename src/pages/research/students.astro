---
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import StatTile from "../../components/StatTile.astro";
import PubItem from "../../components/PubItem.astro";
import { getPublications } from "../../lib/publications";
import { getStats, fmt } from "../../lib/stats";

const s = getStats();
const gradPubs = getPublications()
  .filter((p) => p.ses_grad_students.length > 0 || p.ses_undergrad_students.length > 0)
  .sort((a, b) => (b.year ?? 0) - (a.year ?? 0) || b.citations - a.citations);
const recent = gradPubs.slice(0, 15);
---

<Base
  title="Student Research"
  description={`SES students are authors on ${fmt(s.totalGradPubs)} peer-reviewed publications. Explore student-led science, the graduate research symposium, and past theses.`}
>
  <PageHero
    title="Student Research"
    lede="Our students don't just learn science, they publish it. Explore the papers SES graduate and undergraduate students have authored, and where to find their theses."
  />
  <div class="mx-auto max-w-4xl px-4 py-12">
    <div class="grid gap-4 sm:grid-cols-3">
      <StatTile value={fmt(s.totalGradStudents)} label="Student authors" sub="grad students publishing since 2009" />
      <StatTile value={fmt(s.totalGradPubs)} label="Publications" sub="with grad-student authors" />
      <StatTile value={fmt(s.gradCitations)} label="Citations" sub="to student-authored work" />
    </div>

    <section class="mt-12">
      <h2 class="font-serif text-2xl font-semibold text-pine-900">Recent student-authored publications</h2>
      <div class="mt-2">
        {recent.map((p) => (
          <PubItem pub={p} />
        ))}
      </div>
      <a
        href="/publications/?students=1"
        class="mt-6 inline-block rounded-lg bg-pine-900 px-4 py-2 text-sm font-medium text-white hover:bg-pine-700"
      >
        Browse all {fmt(gradPubs.length)} student-authored papers
      </a>
    </section>

    <section class="mt-14 grid gap-6 sm:grid-cols-2">
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="font-serif text-lg font-semibold text-pine-900">Graduate Research Symposium</h2>
        <p class="mt-2 text-sm text-slate-600">
          Every April, SES graduate students present their research to the school. The
          <a href="/current-students/scholarships/" class="text-pine-600 underline decoration-gold-400 decoration-2 underline-offset-2">Montgomery Award</a>
          honors the best three-minute presentation.
        </p>
      </div>
      <div class="rounded-xl border border-slate-200 bg-white p-6 shadow-sm">
        <h2 class="font-serif text-lg font-semibold text-pine-900">Theses &amp; dissertations</h2>
        <p class="mt-2 text-sm text-slate-600">
          Completed SES theses live in
          <a href="https://www.proquest.com/pqdtlocal1006253/dissertations/fromDatabasesLayer/advanced" class="text-pine-600 underline decoration-gold-400 decoration-2 underline-offset-2">ProQuest @ NAU</a>
          and
          <a href="https://openknowledge.nau.edu/view/divisions/sch=5Fenv.html" class="text-pine-600 underline decoration-gold-400 decoration-2 underline-offset-2">OpenKnowledge@NAU</a>.
          Current students: see
          <a href="/current-students/thesis-defense/" class="text-pine-600 underline decoration-gold-400 decoration-2 underline-offset-2">Thesis &amp; Defense</a>.
        </p>
      </div>
    </section>

    <p class="mt-10 text-sm text-slate-500">
      Student spotlights appear monthly on the
      <a href="/news/" class="text-pine-600 underline decoration-gold-400 decoration-2 underline-offset-2">news page</a>.
    </p>
  </div>
</Base>
