---
import { getCollection, render } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import PubItem from "../../components/PubItem.astro";
import { getPublications } from "../../lib/publications";

export async function getStaticPaths() {
  const news = await getCollection("news");
  return news.map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);
const newsImages = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/news/*/featured.{jpg,jpeg,png,webp}",
);
const newsImageKey = Object.keys(newsImages).find((key) => key.includes(`/${entry.id}/`));
const newsImage = newsImageKey ? (await newsImages[newsImageKey]()).default : undefined;
const pub = entry.data.publication_id
  ? getPublications().find((p) => p.id === entry.data.publication_id)
  : undefined;
const dateFmt = entry.data.date.toLocaleDateString("en-US", {
  year: "numeric",
  month: "long",
  day: "numeric",
  timeZone: "UTC",
});

const articleJsonLd = {
  "@context": "https://schema.org",
  "@type": "NewsArticle",
  headline: entry.data.title,
  description: entry.data.summary,
  datePublished: entry.data.date.toISOString().slice(0, 10),
  author: { "@type": "Organization", name: entry.data.author },
  publisher: {
    "@type": "CollegeOrUniversity",
    name: "School of Earth and Sustainability, Northern Arizona University",
    url: "https://ses-nau.org/",
  },
  mainEntityOfPage: new URL(Astro.url.pathname, Astro.site).href,
};
---

<Base title={entry.data.title} description={entry.data.summary} jsonLd={articleJsonLd}>
  <div class="bg-pine-900 py-10">
    <div class="mx-auto max-w-3xl px-4">
      <p class="text-sm text-pine-200">
        <a href="/news/" class="hover:text-gold-400">News</a> · {dateFmt}
      </p>
      <h1 class="mt-2 font-serif text-3xl font-bold text-white sm:text-4xl">{entry.data.title}</h1>
      <p class="mt-3 text-lg text-pine-100">{entry.data.summary}</p>
    </div>
  </div>
  <div class="h-1.5 bg-gold-400"></div>

  <article class="mx-auto max-w-3xl px-4 py-10">
    {newsImage && (
      <figure class="mb-10">
        <Image
          src={newsImage}
          alt={entry.data.image_caption ?? ""}
          width={1200}
          class="w-full rounded-xl shadow-lg"
        />
        {entry.data.image_caption && (
          <figcaption class="mt-2 text-sm text-slate-500">{entry.data.image_caption}</figcaption>
        )}
      </figure>
    )}

    <div class="prose-ses max-w-none">
      <Content />
    </div>

    {pub && (
      <aside class="mt-10 rounded-xl bg-pine-50 p-5">
        <h2 class="text-sm font-semibold uppercase tracking-wide text-pine-700">The paper</h2>
        <PubItem pub={pub} />
      </aside>
    )}

    <p class="mt-8 text-sm text-slate-500">
      Reported by {entry.data.author} for the School of Earth and Sustainability.
    </p>
  </article>
</Base>
