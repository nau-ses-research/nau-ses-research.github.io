---
import { getCollection } from "astro:content";
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";

const news = (await getCollection("news")).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);

const images = import.meta.glob<{ default: ImageMetadata }>(
  "/src/content/news/*/featured.{jpg,jpeg,png,webp}",
);
function imageFor(id: string) {
  const key = Object.keys(images).find((k) => k.includes(`/${id}/`));
  return key ? images[key]() : undefined;
}
const dateFmt = (d: Date) =>
  d.toLocaleDateString("en-US", { year: "numeric", month: "long", day: "numeric", timeZone: "UTC" });
---

<Base
  title="News"
  description="Research news from NAU's School of Earth and Sustainability, including monthly spotlights on graduate-student-led publications."
>
  <PageHero
    title="News"
    lede="Research stories from the School of Earth and Sustainability, with a monthly spotlight on new graduate-student-led papers."
  />
  <div class="mx-auto max-w-4xl px-4 py-12">
    {news.length === 0 ? (
      <div class="rounded-xl border border-dashed border-slate-300 p-10 text-center text-slate-500">
        <p class="font-serif text-xl text-pine-900">Stories coming soon</p>
        <p class="mt-2 text-sm">
          Starting this fall, we'll publish a monthly spotlight on a new graduate-student-led
          paper. Meanwhile, browse
          <a href="/publications/" class="text-pine-600 underline decoration-gold-400 decoration-2 underline-offset-2">
            the full publication database
          </a>.
        </p>
      </div>
    ) : (
      <div class="space-y-8">
        {await Promise.all(
          news.map(async (n) => {
            const img = await imageFor(n.id);
            return (
              <a
                href={`/news/${n.id}/`}
                class:list={["group grid gap-5 rounded-xl border border-slate-200 bg-white p-5 shadow-sm transition hover:shadow-md", img && "sm:grid-cols-[220px_1fr]"]}
              >
                {img && (
                  <Image
                    src={img.default}
                    alt=""
                    width={440}
                    height={330}
                    class="aspect-[4/3] w-full rounded-lg object-cover"
                  />
                )}
                <div>
                  <p class="text-xs uppercase tracking-wide text-slate-500">{dateFmt(n.data.date)}</p>
                  <h2 class="mt-1 font-serif text-xl font-semibold text-pine-900 group-hover:text-pine-700">
                    {n.data.title}
                  </h2>
                  <p class="mt-2 text-sm text-slate-600">{n.data.summary}</p>
                  {n.data.students.length > 0 && (
                    <p class="mt-2 text-xs text-pine-600">Featuring {n.data.students.join(", ")}</p>
                  )}
                </div>
              </a>
            );
          }),
        )}
      </div>
    )}
    <p class="mt-10 text-center text-sm text-slate-500">
      Subscribe via <a href="/news/rss.xml" class="text-pine-600 underline decoration-gold-400 decoration-2 underline-offset-2">RSS</a>
    </p>
  </div>
</Base>
