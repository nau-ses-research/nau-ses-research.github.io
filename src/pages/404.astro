---
import Base from "../layouts/Base.astro";
---

<Base title="Page Not Found" noindex>
  <div class="mx-auto max-w-2xl px-4 py-24 text-center">
    <p class="font-serif text-7xl font-bold text-pine-200">404</p>
    <h1 class="mt-4 font-serif text-3xl font-bold text-pine-900">Page not found</h1>
    <p class="mt-4 text-slate-600">
      This page may have moved during our 2026 site redesign. The pages below cover most of what
      the old site offered.
    </p>
    <div class="mt-8 flex flex-wrap justify-center gap-3">
      <a href="/" class="rounded-lg bg-pine-900 px-4 py-2 text-sm font-medium text-white hover:bg-pine-700">Home</a>
      <a href="/publications/" class="rounded-lg border border-pine-300 px-4 py-2 text-sm font-medium text-pine-800 hover:bg-pine-50">Publications</a>
      <a href="/research/" class="rounded-lg border border-pine-300 px-4 py-2 text-sm font-medium text-pine-800 hover:bg-pine-50">Research Impact</a>
      <a href="/faculty-profiles/" class="rounded-lg border border-pine-300 px-4 py-2 text-sm font-medium text-pine-800 hover:bg-pine-50">Faculty</a>
      <a href="/student-opportunities/" class="rounded-lg border border-pine-300 px-4 py-2 text-sm font-medium text-pine-800 hover:bg-pine-50">Student Opportunities</a>
    </div>
  </div>
</Base>
