---
import { Image } from "astro:assets";
import Base from "../../layouts/Base.astro";
import PageHero from "../../components/PageHero.astro";
import { gradStudentsByProgram } from "../../lib/gradStudents";

const groups = gradStudentsByProgram();
const total = groups.reduce((n, g) => n + g.students.length, 0);

// Portraits are written by scripts/update_grad_students.py, so a student
// without one simply has no file here and falls back to their initials.
const portraits = import.meta.glob<{ default: ImageMetadata }>(
  "/src/assets/grad-students/*.jpg",
);
async function portraitFor(slug: string) {
  const key = Object.keys(portraits).find((k) => k.endsWith(`/${slug}.jpg`));
  return key ? (await portraits[key]()).default : undefined;
}

const cards = await Promise.all(
  groups.map(async (g) => ({
    ...g,
    students: await Promise.all(
      g.students.map(async (s) => ({ ...s, portrait: await portraitFor(s.slug) })),
    ),
  })),
);
---

<Base
  title="Graduate Students"
  description="Current graduate students in NAU's School of Earth and Sustainability, across the PhD in Earth Sciences and Environmental Sustainability and the MS programs in Geosciences, Environmental Sciences and Policy, and Climate Science and Solutions."
>
  <PageHero
    title="Graduate Students"
    lede={`The ${total} graduate students currently working across our research and professional programs.`}
  />

  <div class="mx-auto max-w-6xl px-4 py-12">
    <div class="flex flex-wrap items-center gap-x-3 gap-y-2 border-b border-slate-200 pb-5" data-filters>
      {cards.map((g) => (
        <button
          type="button"
          data-program={g.code}
          class="rounded-full border border-slate-300 px-3 py-1 text-sm text-slate-700 transition hover:border-pine-500 hover:text-pine-800 aria-pressed:border-pine-700 aria-pressed:bg-pine-700 aria-pressed:text-white"
          aria-pressed="false"
        >
          {g.label} <span class="opacity-70">({g.students.length})</span>
        </button>
      ))}
      <label class="ml-auto flex items-center gap-2 text-sm text-slate-600">
        <span class="sr-only">Search students by name or advisor</span>
        <input
          type="search"
          placeholder="Search name or advisor"
          data-search
          class="w-56 rounded-full border border-slate-300 px-3 py-1 text-sm focus:border-pine-500 focus:outline-none"
        />
      </label>
    </div>
    <p class="mt-3 text-sm text-slate-600" data-count aria-live="polite">
      Showing all {total} students.
    </p>

    {cards.map((g) => (
      <section class="mt-10" data-group={g.code}>
        <h2 class="font-serif text-2xl font-semibold text-pine-900">{g.label}</h2>
        <div class="mt-5 grid gap-5 sm:grid-cols-2 lg:grid-cols-3">
          {g.students.map((s) => (
            <article
              class="flex gap-4 rounded-xl border border-slate-200 bg-white p-4 shadow-sm"
              data-student
              data-program={s.program}
              data-search-text={`${s.full_name} ${s.advisors.map((a) => a.name).join(" ")}`.toLowerCase()}
            >
              {s.portrait ? (
                <Image
                  src={s.portrait}
                  alt=""
                  width={128}
                  height={128}
                  class="h-16 w-16 shrink-0 rounded-full object-cover object-[50%_20%]"
                />
              ) : (
                <span
                  class="flex h-16 w-16 shrink-0 items-center justify-center rounded-full bg-pine-100 font-serif text-lg font-semibold text-pine-700"
                  aria-hidden="true"
                >
                  {s.initials}
                </span>
              )}
              <div class="min-w-0">
                <h3 class="font-medium text-pine-900">
                  <a href={`/graduate-students/${s.slug}/`} class="hover:text-pine-700 hover:underline">
                    {s.full_name}
                  </a>
                </h3>
                {s.advisors.length > 0 && (
                  <p class="mt-0.5 text-sm text-slate-600">
                    Advised by{" "}
                    {s.advisors.map((a, i) => (
                      <>
                        {i > 0 && " and "}
                        {a.href ? (
                          <a href={a.href} class="text-pine-700 hover:text-pine-900">{a.name}</a>
                        ) : (
                          a.name
                        )}
                      </>
                    ))}
                  </p>
                )}
                {s.cohort && <p class="mt-0.5 text-sm text-slate-600">{s.cohort}</p>}
                {s.email && (
                  <p class="mt-1 truncate text-sm">
                    <a href={`mailto:${s.email}`} class="text-pine-700 hover:text-pine-900">
                      {s.email}
                    </a>
                  </p>
                )}
                {s.council_rep && (
                  <p class="mt-1 inline-block rounded bg-gold-100 px-2 py-0.5 text-xs font-medium text-pine-800">
                    Grad Student Council rep, 2026-27
                  </p>
                )}
              </div>
            </article>
          ))}
        </div>
      </section>
    ))}

    <p class="mt-10 hidden text-slate-600" data-empty>Nobody matches that search.</p>

    <p class="mt-12 border-t border-slate-200 pt-5 text-sm text-slate-600">
      Prospective students: see
      <a href="/student-opportunities/find-an-advisor/" class="text-pine-700 underline decoration-gold-400 decoration-2 underline-offset-2">which faculty are recruiting</a>
      and write to them before you apply.
    </p>
  </div>

  <script>
    const root = document.querySelector("[data-filters]");
    const search = document.querySelector<HTMLInputElement>("[data-search]");
    const cards = [...document.querySelectorAll<HTMLElement>("[data-student]")];
    const groups = [...document.querySelectorAll<HTMLElement>("[data-group]")];
    const count = document.querySelector("[data-count]")!;
    const empty = document.querySelector("[data-empty]")!;
    const active = new Set<string>();

    function apply() {
      const q = (search?.value ?? "").trim().toLowerCase();
      let shown = 0;
      for (const card of cards) {
        const okProgram = active.size === 0 || active.has(card.dataset.program ?? "");
        const okSearch = !q || (card.dataset.searchText ?? "").includes(q);
        const show = okProgram && okSearch;
        card.classList.toggle("hidden", !show);
        if (show) shown++;
      }
      // Hide a program heading when nothing under it survives the filter.
      for (const g of groups) {
        const any = [...g.querySelectorAll<HTMLElement>("[data-student]")].some(
          (c) => !c.classList.contains("hidden"),
        );
        g.classList.toggle("hidden", !any);
      }
      count.textContent =
        active.size === 0 && !q
          ? `Showing all ${cards.length} students.`
          : `Showing ${shown} of ${cards.length} students.`;
      empty.classList.toggle("hidden", shown > 0);
    }

    root?.addEventListener("click", (e) => {
      const btn = (e.target as HTMLElement).closest<HTMLElement>("button[data-program]");
      if (!btn) return;
      const code = btn.dataset.program!;
      const on = btn.getAttribute("aria-pressed") === "true";
      btn.setAttribute("aria-pressed", on ? "false" : "true");
      on ? active.delete(code) : active.add(code);
      apply();
    });
    search?.addEventListener("input", apply);
  </script>
</Base>
